(
    version: 1,
    technologies: [
        (
            id: "spatial_detection",
            name: "Veille sidérale",
            description: "Corrèle les signaux faibles afin de repérer les systèmes encore inconnus.",
            required_milli_points: 15000,
            prerequisites: [],
            unlock: DetectUnknownSystems,
            unlock_label: "Cartographie des signaux inconnus",
        ),
        (
            id: "propulsion",
            name: "Propulsion à flux",
            description: "Stabilise des moteurs capables de soutenir un transit interstellaire.",
            required_milli_points: 20000,
            prerequisites: ["spatial_detection"],
            unlock: InterstellarTravel,
            unlock_label: "Transit interstellaire",
        ),
        (
            id: "cargo_capacity",
            name: "Architecture de soute",
            description: "Standardise des modules de fret compacts pour les flottes logistiques.",
            required_milli_points: 25000,
            prerequisites: ["propulsion"],
            unlock: ExpandedCargo,
            unlock_label: "Soutes modulaires",
        ),
        (
            id: "remote_extraction",
            name: "Prospection autonome",
            description: "Coordonne l'exploitation temporaire de sites éloignés sans implantation.",
            required_milli_points: 30000,
            prerequisites: ["cargo_capacity"],
            unlock: RemoteExtraction,
            unlock_label: "Extraction hors-colonie",
        ),
        (
            id: "planetary_analysis",
            name: "Spectrométrie planétaire",
            description: "Établit le profil physique et biologique complet d'un monde observé.",
            required_milli_points: 25000,
            prerequisites: ["spatial_detection"],
            unlock: AnalyzePlanets,
            unlock_label: "Diagnostic planétaire complet",
        ),
        (
            id: "colonization",
            name: "Ingénierie d'implantation",
            description: "Formalise les infrastructures nécessaires à une colonie autonome.",
            required_milli_points: 45000,
            prerequisites: ["cargo_capacity", "planetary_analysis"],
            unlock: FoundColonies,
            unlock_label: "Fondation d'avant-postes",
        ),
    ],
)
