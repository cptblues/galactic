(
    version: 2,
    technologies: [
        (
            id: "spatial_detection",
            name: "Détection longue portée",
            description: "Améliore la portée des systèmes de surveillance. Une menace repérée suffisamment tôt devient une menace officiellement anticipée.",
            required_milli_points: 15000,
            prerequisites: [],
            building_prerequisites: [],
            unlock: DetectUnknownSystems,
            unlock_label: "Détection de systèmes inconnus",
        ),
        (
            id: "propulsion",
            name: "Propulsion avancée",
            description: "Augmente la vitesse des vaisseaux grâce à des moteurs plus puissants et à une réduction contrôlée des marges de prudence.",
            required_milli_points: 20000,
            prerequisites: ["spatial_detection"],
            building_prerequisites: [
                (id: "research_lab", level: 2),
            ],
            unlock: InterstellarTravel,
            unlock_label: "Transit interstellaire",
        ),
        (
            id: "cargo_capacity",
            name: "Soutes agrandies",
            description: "Optimise l'espace de chargement en supprimant les volumes inutilement réservés au confort de l'équipage.",
            required_milli_points: 32000,
            prerequisites: ["propulsion"],
            building_prerequisites: [
                (id: "research_lab", level: 3),
            ],
            unlock: ExpandedCargo,
            unlock_label: "Capacité cargo augmentée",
        ),
        (
            id: "remote_extraction",
            name: "Extraction automatisée",
            description: "Permet aux installations minières de poursuivre leur production avec une intervention humaine réduite et une reconnaissance sociale équivalente.",
            required_milli_points: 42000,
            prerequisites: ["cargo_capacity"],
            building_prerequisites: [
                (id: "research_lab", level: 3),
            ],
            unlock: RemoteExtraction,
            unlock_label: "Récolte distante automatisée",
        ),
        (
            id: "planetary_analysis",
            name: "Analyse planétaire",
            description: "Révèle les ressources et propriétés des mondes observés. Une planète correctement cataloguée est déjà partiellement administrée.",
            required_milli_points: 25000,
            prerequisites: ["spatial_detection"],
            building_prerequisites: [
                (id: "research_lab", level: 2),
            ],
            unlock: AnalyzePlanets,
            unlock_label: "Rapport planétaire complet",
        ),
        (
            id: "colonization",
            name: "Colonisation avancée",
            description: "Améliore l'autonomie des nouvelles colonies et réduit les délais entre l'atterrissage et la première déclaration officielle de prospérité.",
            required_milli_points: 70000,
            prerequisites: ["cargo_capacity", "planetary_analysis"],
            building_prerequisites: [
                (id: "research_lab", level: 4),
                (id: "construction_center", level: 3),
            ],
            unlock: FoundColonies,
            unlock_label: "Fondation de colonies avancées",
        ),
    ],
)
