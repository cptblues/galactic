            cost_growth_per_mille: 1500,
            base_duration_seconds: 40,
            duration_growth_per_mille: 1300,
            energy_consumption_per_level: 0,
            effect: EnergyProduction(capacity_per_level: 80),
            prerequisites: [],
        ),
        (
            id: "warehouse",
