(
    version: 1,
    buildings: [
        (
            id: "metal_mine",
            name: "Mine de métal",
            description: "Extrait les métaux indispensables à la construction d'infrastructures civiles, militaires et civilement militaires. Chaque tonne produite rapproche la colonie de son autonomie réglementaire.",
            max_level: 10,
            base_cost: (metal: 120, crystal: 60, fuel: 20),
            cost_growth_per_mille: 1450,
